<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Nullable>disable</Nullable>
    </PropertyGroup>

      <!-- Use project build name as assembly name to satisfy benchmark.NET -->
  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

    <PropertyGroup Label="No strong named assembly references">
        <NoWarn>$(NoWarn);CS8002</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BenchmarkBaselineAssembly)' != ''">
        <DefineConstants>$(DefineConstants);BENCHMARK_BASELINE</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(BenchmarkBaselineAssembly)' != ''">
        <Reference Include="MyCSharp.HttpUserAgentParser.Baseline">
            <HintPath>$(BenchmarkBaselineAssembly)</HintPath>
            <Aliases>Baseline</Aliases>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    </ItemGroup>

    <ItemGroup Label="Libraries for comparison">
        <PackageReference Include="UAParser" />
        <PackageReference Include="DeviceDetector.NET" />
        <PackageReference Include="Ng.UserAgentService" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\HttpUserAgentParser\HttpUserAgentParser.csproj" />
        <ProjectReference Include="..\..\tests\HttpUserAgentParser.TestHelpers\HttpUserAgentParser.TestHelpers.csproj" />
    </ItemGroup>

</Project>
